---
// /sprzedaj-z-nami/ (Etap 5A, docs/analiza-formularze-a.md): hero ze
// zdjęciem pod przezroczystym paskiem, trzy kroki i formularz „Zgłoś
// nieruchomość". Czysty Astro + moduł formularzy (ładowany zawsze — to
// funkcja, nie dekoracja).
//
// RUCH (reveale od kroków w dół, parallax zdjęcia hero) siedzi
// w sell-motion.ts, ładowanym DYNAMICZNIE tylko przy
// prefers-reduced-motion: no-preference; stany startowe uzbraja
// html.js-motion (MotionGate.astro). Bez JS i przy reduce strona jest
// statyczna i kompletna. Zdjęcie hero i `h1` to kandydaci LCP: preload
// w <head>, żadnego reveala.
import heroTall from "@/assets/img/sprzedaj-doradca-tall.webp";
import hero from "@/assets/img/sprzedaj-doradca.webp";
import Footer from "@/components/Footer.astro";
import MotionGate from "@/components/MotionGate.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import "@/components/sections/content.css";
import { SELL_HERO_TALL_BELOW_PX } from "@/components/sections/sell/sell-config";
import SellForm from "@/components/sections/sell/SellForm.astro";
import SellHero from "@/components/sections/sell/SellHero.astro";
import SellSteps from "@/components/sections/sell/SellSteps.astro";
import { ui } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={ui.pl["sellPage.title"]}
  description={ui.pl["sellPage.description"]}
>
  {/* zdjęcie hero: jeden preload per kadr (jak <picture> w SellHero) */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroTall.src}
    media={`(max-width: ${SELL_HERO_TALL_BELOW_PX - 1}px)`}
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={hero.src}
    media={`(min-width: ${SELL_HERO_TALL_BELOW_PX}px)`}
    fetchpriority="high"
  />
  {/* bramka ruchu: html.js-motion PRZED malowaniem + bezpiecznik */}
  <MotionGate slot="head" />

  {/* hero stoi POD paskiem — wariant przezroczysty, próg z wysokości hero */}
  <Navbar overHero />

  <main class="sell">
    <SellHero />
    <SellSteps />
    <SellForm />
  </main>

  <Footer />
</BaseLayout>

<script>
  import { initForms } from "@/components/forms/form-ui";
  import { armViewportPin } from "@/components/sections/content-viewport";

  initForms();

  // stabilna wysokość hero — układ, nie dekoracja, więc poza bramką ruchu
  const sell = document.querySelector<HTMLElement>("main.sell");
  if (sell) armViewportPin(sell);

  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    import("@/components/sections/sell/sell-motion").catch(() => {
      document.documentElement.classList.remove("js-motion");
    });
  }
</script>

<style>
  /* `--svh` przypina content-viewport.ts dopiero wtedy, gdy przeglądarka
     rusza wysokością okna bez zmiany szerokości; domyślnie czysty CSS */
  .sell {
    --svh: 100svh;
    background: var(--bg);
  }
</style>
