---
// Trasy ofert — WERSJA SZKIELETOWA (2.8). Adresy list i detali powstają
// z danych (`data.ts` → `offerRoutes()`), żeby cały łańcuch CRM → data/ →
// build → adres → zdjęcie z zasobnika → przekierowanie `/{NUMER}` dał się
// sprawdzić od pierwszego syncu. Treść minimalna, bez stylu docelowego —
// widoki 4.2 (lista, wyszukiwarka, /oferty/index.json) i 4.3 (detal)
// podmieniają treść, nie adresy. Selektor `main h1` = kontrakt smoke.
import SkeletonPage from "@/components/SkeletonPage.astro";
import { imgAt, mediaUrl } from "@/lib/img";
import { loadOffersData } from "@/lib/offers/data";
import { formatKind, formatLocation, formatPrice } from "@/lib/offers/format";
import { coordKey } from "@/lib/offers/map-key";
import type { Offer } from "@/lib/offers/schema";
import {
  offerStaticPaths,
  type OfferRouteProps,
} from "@/lib/offers/static-paths";
import { offerPath } from "@/lib/offers/urls";

export function getStaticPaths() {
  return offerStaticPaths(loadOffersData().offers);
}

const props = Astro.props as OfferRouteProps;
const { maps } = loadOffersData();

function photoUrl(offer: Offer): string | undefined {
  const first = offer.photos[0];
  return first ? imgAt(first.r2Key, "card") : undefined;
}
function mapUrl(offer: Offer): string | undefined {
  const entry = maps[coordKey(offer.location.lat, offer.location.lon)];
  if (!entry || entry.goneSince) return undefined;
  return import.meta.env.MEDIA_SOURCE === "fixture"
    ? imgAt(entry.r2Key, "card")
    : mediaUrl(entry.r2Key);
}

const first = props.kind === "list" ? props.offers[0] : props.offer;
const heading =
  props.kind === "list"
    ? `${formatKind(first.mainType, first.transaction)} — ${props.offers.length}`
    : props.offer.title || props.offer.number;
const title =
  props.kind === "list"
    ? `${formatKind(first.mainType, first.transaction)} — Oferty`
    : `${props.offer.title || props.offer.number} — Oferta ${props.offer.number}`;
---

<SkeletonPage title={title} heading={heading}>
  {
    props.kind === "list" ? (
      <ul data-offer-list>
        {props.offers.map((offer) => (
          <li data-offer-card={offer.number}>
            <a href={offerPath(offer)}>
              {offer.number} · {offer.title || offer.typeName} ·{" "}
              {formatPrice(offer.price, offer.transaction, offer.currency)} ·{" "}
              {formatLocation(offer.location)}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <article data-offer-detail={props.offer.number}>
        <p data-offer-number>{props.offer.number}</p>
        <p data-offer-price>
          {formatPrice(
            props.offer.price,
            props.offer.transaction,
            props.offer.currency,
          )}
        </p>
        <p>{formatLocation(props.offer.location)}</p>
        {photoUrl(props.offer) && (
          <img
            src={photoUrl(props.offer)}
            alt={props.offer.photos[0].alt}
            width={props.offer.photos[0].width}
            height={props.offer.photos[0].height}
            loading="lazy"
            decoding="async"
            data-offer-photo
          />
        )}
        {mapUrl(props.offer) && (
          <img
            src={mapUrl(props.offer)}
            alt=""
            loading="lazy"
            decoding="async"
            data-offer-map
          />
        )}
      </article>
    )
  }
</SkeletonPage>
