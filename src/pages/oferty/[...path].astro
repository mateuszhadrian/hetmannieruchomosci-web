---
// Trasy ofert: listy typ × transakcja [× lokalizacja] w widoku 4.2
// (`OffersListPage`) oraz detal w widoku 4.3 (`OfferDetailPage`). Adresy
// powstają z danych (`data.ts` → `offerRoutes()`) — wyłącznie kombinacje
// z ≥ 1 ofertą (D30). Kontrakty: `main h1` (smoke), `data-offer-detail/
// -number/-price` (detal; szkielet S2c niósł je jako pierwsze).
import OfferDetailPage from "@/components/offers/OfferDetailPage.astro";
import OffersListPage from "@/components/offers/OffersListPage.astro";
import { loadOffersData } from "@/lib/offers/data";
import { parsePath } from "@/lib/offers/filters";
import {
  offerStaticPaths,
  type OfferRouteProps,
} from "@/lib/offers/static-paths";
import { OFFERS_PATH } from "@/lib/offers/urls";

export function getStaticPaths() {
  return offerStaticPaths(loadOffersData().offers);
}

const props = Astro.props as OfferRouteProps;

// Kontekst listy ze ścieżki (typ, transakcja, segment lokalizacji);
// etykieta lokalizacji z pierwszej oferty (wszystkie mają ten sam slug).
const path = `${OFFERS_PATH}${Astro.params.path}/`;
const listContext =
  props.kind === "list"
    ? (() => {
        const p = parsePath(path);
        return {
          mainType: p.mainType,
          transaction: p.transaction,
          locationSlug: p.locationSlug,
          locationLabel: p.locationSlug
            ? props.offers[0]?.location.placeName
            : undefined,
        };
      })()
    : undefined;
---

{
  props.kind === "list" ? (
    <OffersListPage offers={props.offers} context={listContext!} />
  ) : (
    <OfferDetailPage offer={props.offer} />
  )
}
