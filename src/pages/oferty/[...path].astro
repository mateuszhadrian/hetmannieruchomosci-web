---
// Listy ofert: typ × transakcja [× lokalizacja] w widoku 4.2
// (`OffersListPage`). Adresy powstają z danych (`data.ts` →
// `offerRoutes()`) — wyłącznie kombinacje z ≥ 1 ofertą (D30). Detale mają
// OSOBNĄ trasę (`[kind]/[location]/[number].astro`): Astro linkuje arkusze
// per plik trasy, więc wspólny plik ładował style detalu i formularza
// także na listach. Kontrakt: `main h1` (smoke).
import OffersListPage from "@/components/offers/OffersListPage.astro";
import { loadOffersData } from "@/lib/offers/data";
import { parsePath } from "@/lib/offers/filters";
import {
  offerListStaticPaths,
  type OfferListStaticPath,
} from "@/lib/offers/static-paths";
import { OFFERS_PATH } from "@/lib/offers/urls";

export function getStaticPaths() {
  return offerListStaticPaths(loadOffersData().offers);
}

const { offers } = Astro.props as OfferListStaticPath["props"];

// Kontekst listy ze ścieżki (typ, transakcja, segment lokalizacji);
// etykieta lokalizacji z pierwszej oferty (wszystkie mają ten sam slug).
const p = parsePath(`${OFFERS_PATH}${Astro.params.path}/`);
const listContext = {
  mainType: p.mainType,
  transaction: p.transaction,
  locationSlug: p.locationSlug,
  locationLabel: p.locationSlug ? offers[0]?.location.placeName : undefined,
};
---

<OffersListPage offers={offers} context={listContext} />
