---
// Strona 404. Astro buduje ją jako dist/404.html, a Cloudflare Pages
// serwuje ten plik pod KAŻDYM nieistniejącym adresem z prawdziwym statusem
// 404. Bez niego Pages uznawał serwis za SPA i odpowiadał na śmieciowy
// adres stroną główną z kodem 200 (soft-404 — Google indeksowałby takie
// adresy jako kopie „/").
//
// Dobre praktyki stron 404, które tu obowiązują:
// — `noindex`, bez canonicala i og:url (prop BaseLayout), bez JSON-LD
//   i poza sitemapą (kontrakt w tests/e2e/seo.spec.ts);
// — pełny chrome (navbar + stopka), żeby z błędnego adresu dało się
//   wyjść w dowolne miejsce serwisu, a nie tylko na stronę główną;
// — jeden jasny komunikat i jedna akcja; h1 niesie dla czytników pełną
//   nazwę błędu („Błąd 404 — nie znaleziono strony"), wizualnie samo 404;
// — linki ABSOLUTNE od „/" — ta sama treść odpowiada pod adresami
//   dowolnej głębokości (/a/b/c/), więc ścieżki względne by się rozjechały
//   (Astro i tak emituje assety absolutnie);
// — zero modułów JS widoku (jedyne moduły strony to chrome) i zero nowych
//   assetów.
//
// WARIANT ŚWIADOMY OFERT (4.3 b, docs/analiza-oferta.md §3.6 i §11): ten
// sam plik odpowiada pod KAŻDYM błędnym adresem, więc wygasły adres oferty
// (`/oferty/…` albo krótki `/SW…`) rozpoznaje dopiero przeglądarka —
// skryptem INLINE, przed pierwszym malowaniem. Blok ofertowy (komunikat
// + do 3 najnowszych aktywnych ofert, renderowanych statycznie) siedzi
// w `<template>`: skrypt podmienia nim blok generyczny, więc w DOM jest
// zawsze dokładnie jeden `h1`, a zdjęcia kart nie pobierają się na
// zwykłej 404. Bez JS zostaje komunikat generyczny.
import "@/components/offers/offers.css";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import { OfferCard } from "@/components/offers/OfferCard";
import { ui } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BUILD_NOW, loadOffersData } from "@/lib/offers/data";
import { sortEntries } from "@/lib/offers/filters";
import { toIndexEntry } from "@/lib/offers/index-entry";
import { DETAIL } from "@/lib/offers/offers-ui";
import { OFFERS_PATH } from "@/lib/offers/urls";
import { HOME_PATH } from "@/lib/routes";

/** Liczba kart w wariancie ofertowym (przy mniejszej liczbie aktywnych —
 *  tyle, ile jest; przy zerze sam komunikat). */
const NF_LATEST = 3;
const { offers } = loadOffersData();
// „najnowsze" jak na liście: `sortEntries` czyta `SORT_NEWEST_BY`
const latest = sortEntries(
  offers.filter((o) => o.status === "aktywna").map(toIndexEntry),
  "newest",
).slice(0, NF_LATEST);
const nowIso = BUILD_NOW.toISOString();
---

<BaseLayout title={ui.pl["notFoundPage.title"]} noindex>
  <Navbar />

  <main class="nf">
    <div class="nf-in" data-nf-generic>
      <h1 class="nf-code">
        <span class="sr-only">Błąd </span>404<span class="sr-only">
          — nie znaleziono strony</span
        >
      </h1>
      <span class="nf-rule" aria-hidden="true"></span>
      <p class="nf-txt">
        Strona o podanym adresie nie istnieje. Sprawdź adres i spróbuj ponownie.
      </p>
      <a class="nf-btn" href={HOME_PATH}>
        <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true"
          ><path
            d="M15 6H2M6.5 1.5L2 6l4.5 4.5"
            stroke="currentColor"
            stroke-width="1.4"
            fill="none"></path></svg
        >
        <span>Powrót na stronę główną</span>
      </a>
    </div>

    <template data-nf-tpl data-title={DETAIL.nfHeading}>
      <div class="nf-offer" data-nf-offer>
        <div class="nf-offer-head">
          <h1 class="nf-h">{DETAIL.nfHeading}</h1>
          <span class="nf-rule" aria-hidden="true"></span>
          <p class="nf-txt nf-txt--offer">
            {latest.length > 0 ? DETAIL.nfText : DETAIL.nfTextEmpty}
          </p>
          <a class="nf-btn" href={OFFERS_PATH} data-nf-link>
            <span>{DETAIL.nfLink}</span>
            <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true"
              ><path
                d="M1 6h13M9.5 1.5L14 6l-4.5 4.5"
                stroke="currentColor"
                stroke-width="1.4"
                fill="none"></path></svg
            >
          </a>
        </div>
        {
          latest.length > 0 && (
            <section class="nf-latest" aria-labelledby="nf-latest-h">
              <h2 class="nf-h2" id="nf-latest-h">
                {DETAIL.nfLatest}
              </h2>
              <ul class="ol-grid" data-nf-cards>
                {latest.map((entry) => (
                  <li>
                    <OfferCard entry={entry} nowIso={nowIso} priority="lazy" />
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </template>
    <script is:inline>
      // wygasły adres oferty → wariant ofertowy (podmiana przed malowaniem)
      (() => {
        const p = location.pathname;
        if (!p.startsWith("/oferty/") && !/^\/sw\d+\/?$/i.test(p)) return;
        const tpl = document.querySelector("template[data-nf-tpl]");
        const generic = document.querySelector("[data-nf-generic]");
        if (!tpl || !generic) return;
        generic.replaceWith(tpl.content);
        document.querySelector(".nf").setAttribute("data-nf-variant", "offer");
        document.title = document.title.replace(
          /^[^—]+/,
          tpl.dataset.title + " ",
        );
      })();
    </script>
  </main>

  <Footer />
</BaseLayout>

<style>
  .nf {
    background: var(--bg);
    /* komunikat zajmuje pierwszy ekran (pod fixed paskiem), stopka pod
       zgięciem — 404 nie „wisi" nad stopką na wysokim ekranie */
    min-height: 100svh;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    padding: calc(var(--hdr-h) + 32px) 24px 72px;
  }

  .nf-in {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 560px;
    text-align: center;
  }

  .nf-code {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 600;
    font-size: clamp(104px, 30vw, 150px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--navy);
  }

  .nf-rule {
    display: block;
    width: 56px;
    height: 2px;
    margin: 22px 0 24px;
    background: var(--copper);
  }

  .nf-txt {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--slate);
    text-wrap: balance;
  }

  .nf-btn {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin-top: 32px;
    padding: 14px 22px;
    border: 1px solid var(--navy);
    color: var(--navy);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .nf-btn:hover {
    background: var(--navy);
    color: #fff;
  }
  .nf-btn:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 3px;
  }
  .nf-btn svg {
    flex: none;
  }

  /* ── wariant ofertowy: komunikat od góry + siatka kart z `offers.css` ── */
  .nf[data-nf-variant="offer"] {
    display: block;
    /* `place-items: center` układu generycznego działa też w układzie
       blokowym (justify-self) — kolumna kurczyłaby się do treści */
    place-items: normal;
    min-height: 0;
    padding-bottom: clamp(48px, 12vw, 72px);
  }
  .nf-offer {
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 9vw, 56px);
    box-sizing: border-box;
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
  }
  .nf-offer-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .nf-h {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 7.8vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--navy);
    text-wrap: balance;
  }
  .nf-txt--offer {
    max-width: 52ch;
    text-wrap: pretty;
  }
  .nf-h2 {
    margin: 0 0 clamp(14px, 4vw, 20px);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 6.2vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--navy);
  }
  .nf-latest .ol-grid {
    margin-top: 0;
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .nf {
      padding: calc(var(--hdr-h) + 48px) var(--g) 96px;
    }
    .nf-code {
      font-size: clamp(150px, 13vw, 220px);
    }
    .nf-rule {
      margin: clamp(22px, 2vw, 32px) 0 clamp(24px, 2.2vw, 34px);
    }
    .nf-txt {
      font-size: clamp(16px, 1.2vw, 19px);
    }
    .nf-btn {
      margin-top: clamp(32px, 2.8vw, 44px);
    }
    .nf[data-nf-variant="offer"] {
      padding-bottom: 96px;
    }
    .nf-h {
      font-size: clamp(36px, 3.2vw, 48px);
    }
    .nf-h2 {
      font-size: clamp(26px, 2vw, 30px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-btn {
      transition: none;
    }
  }
</style>
