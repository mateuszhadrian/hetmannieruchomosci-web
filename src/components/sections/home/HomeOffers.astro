---
// 02 Oferty (4.4, docs/analiza-home.md §1.2, Q2–Q4): nagłówek, akapit,
// do trzech kafli NAJNOWSZYCH AKTYWNYCH ofert z danych (`pickHomeOffers`
// — makieta ma kafle wpisane na sztywno), wejście na /oferty/. Telefon
// i tablet: karuzela pozioma (`scroll-snap`, kontrakt `scroll-snap-stop:
// always`); desktop: siatka — 3 kafle = duży + dwa mniejsze, 2 = dwa
// równe, 1 = jeden na całą szerokość. Zero aktywnych ofert: sekcja
// zostaje bez siatki (lista /oferty/ ma własny stan pusty).
import { BUILD_NOW, loadOffersData } from "@/lib/offers/data";
import { pickHomeOffers } from "@/lib/offers/home-offers";
import SectionHead from "../SectionHead.astro";
import { HOME_OFFERS_MAX } from "./home-config";
import { HOME_COPY } from "./home-copy";
import HomeOfferTile from "./HomeOfferTile.astro";

const t = HOME_COPY.offers;
const { offers } = loadOffersData();
const latest = pickHomeOffers(offers, HOME_OFFERS_MAX);
---

<section
  class="sx-sec ho"
  data-home="oferty"
  data-build-now={BUILD_NOW.toISOString()}
  aria-labelledby="home-oferty-h"
>
  <div class="sx-in ho-in">
    <div class="ho-head" data-rv>
      <SectionHead
        id="home-oferty-h"
        eyebrow={t.eyebrow}
        title={t.title}
        accent={t.accent}
      />
    </div>
    <p class="sx-text ho-text" data-rv style="--rvd: 0.07s">{t.text}</p>
    {
      latest.length > 0 && (
        <ul
          class="ho-grid"
          data-home-offers
          data-count={latest.length}
          data-rv
          style="--rvd: 0.14s"
          aria-label={t.listLabel}
        >
          {latest.map((entry, i) => (
            <li>
              <HomeOfferTile
                entry={entry}
                now={BUILD_NOW}
                large={i === 0 && latest.length === HOME_OFFERS_MAX}
              />
            </li>
          ))}
        </ul>
      )
    }
    <div class="ho-act" data-rv>
      <a class="sx-btn" href={t.href}>{t.cta}</a>
    </div>
  </div>
</section>

<style>
  .ho {
    /* margines sekcji (jak .sx-sec) — karuzela wychodzi o niego do
       krawędzi ekranu; 100vw liczy też klasyczny pasek przewijania,
       stąd przycięcie w poziomie */
    --ho-gut: max(var(--pad), calc((100vw - 600px) / 2));
    overflow-x: clip;
    background: var(--bg);
  }
  .ho-in {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 7vw, 40px);
  }
  /* karuzela: wychodzi do krawędzi ekranu, pierwszy kafel stoi w kolumnie */
  .ho-grid {
    display: flex;
    gap: clamp(12px, 3.4vw, 16px);
    margin: 0 calc(-1 * var(--ho-gut));
    padding: 0 var(--ho-gut);
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--ho-gut);
    scrollbar-width: none;
  }
  .ho-grid::-webkit-scrollbar {
    display: none;
  }
  /* prawy margines karuzeli (padding kontenera przewijanego bywa
     pomijany na końcu toru) */
  .ho-grid::after {
    content: "";
    flex: 0 0 1px;
  }
  .ho-grid li {
    flex: 0 0 82%;
    aspect-ratio: 3 / 4;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .ho-grid[data-count="1"] li {
    flex-basis: 100%;
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .ho-in {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: clamp(40px, 4vw, 88px);
      row-gap: clamp(16px, 1.5vw, 24px);
      align-items: end;
    }
    .ho-head {
      grid-column: 1;
      grid-row: 1;
    }
    .ho-head :global(.sx-h2) {
      max-width: 26ch;
    }
    .ho-text {
      grid-column: 1;
      grid-row: 2;
      max-width: 52ch;
    }
    .ho-act {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .ho-grid {
      grid-column: 1 / -1;
      grid-row: 3;
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-rows: 1fr 1fr;
      gap: clamp(20px, 2vw, 32px);
      margin: clamp(16px, 1.7vw, 28px) 0 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
    .ho-grid::after {
      content: none;
    }
    .ho-grid li {
      aspect-ratio: auto;
      min-height: clamp(170px, 17vw, 244px);
    }
    .ho-grid li:first-child {
      grid-row: 1 / span 2;
      min-height: clamp(380px, 36vw, 520px);
    }
    /* duży kafel: większa typografia i promień */
    .ho-grid[data-count="3"] li:first-child :global(.ht) {
      border-radius: 0 0 0 clamp(28px, 2.8vw, 44px);
    }
    .ho-grid[data-count="3"] li:first-child :global(.ht-body) {
      gap: clamp(10px, 0.9vw, 14px);
      padding: clamp(24px, 2.4vw, 40px);
    }
    .ho-grid[data-count="3"] li:first-child :global(.ht-kicker) {
      font-size: clamp(11px, 0.85vw, 13px);
    }
    .ho-grid[data-count="3"] li:first-child :global(.ht-title) {
      max-width: 24ch;
      font-size: clamp(22px, 2vw, 32px);
      line-height: 1.22;
      letter-spacing: -0.015em;
    }
    .ho-grid[data-count="3"] li:first-child :global(.ht-loc) {
      font-size: clamp(15px, 1.1vw, 18px);
    }
    .ho-grid[data-count="3"] li:first-child :global(.ht-price) {
      font-size: clamp(26px, 2.3vw, 38px);
    }
    .ho-grid[data-count="3"] li:first-child :global(.ht-shade) {
      background: linear-gradient(
        180deg,
        rgba(14, 32, 60, 0) 38%,
        rgba(14, 32, 60, 0.76) 70%,
        rgba(14, 32, 60, 0.95)
      );
    }
    /* dwa kafle: dwie równe kolumny; jeden: cała szerokość */
    .ho-grid[data-count="2"] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
    }
    .ho-grid[data-count="1"] {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
    }
    .ho-grid[data-count="2"] li,
    .ho-grid[data-count="1"] li {
      grid-row: auto;
      min-height: clamp(380px, 36vw, 520px);
    }
  }
</style>
