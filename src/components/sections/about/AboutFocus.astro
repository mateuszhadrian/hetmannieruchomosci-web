---
// 03 Specjalizacja (4.5, docs/analiza-o-nas.md §1, A3, A7): biała sekcja.
// JEDNA treść w strukturze desktopowej designu (akapit, dopisek, lista
// trzech pozycji) na obu progach. Telefon: tekst, potem dwa zdjęcia 4:5;
// desktop: zdjęcie „umowa" na całą wysokość sekcji, do lewej krawędzi
// okna, tekst z prawej. Zdjęcie „dokumentacja" tylko poniżej 1025 px
// (`lazy` — desktop go nie pobiera).
import paperworkM from "@/assets/img/onas-dokumentacja-m.webp";
import contractM from "@/assets/img/onas-umowa-m.webp";
import contract from "@/assets/img/onas-umowa.webp";
import SectionHead from "../SectionHead.astro";
import { ABOUT_COPY } from "./about-copy";

const t = ABOUT_COPY.focus;
---

<section
  class="af"
  data-about="specjalizacja"
  aria-labelledby="about-specjalizacja-h"
>
  <div class="af-body">
    <div data-rv>
      <SectionHead
        id="about-specjalizacja-h"
        eyebrow={t.eyebrow}
        title={t.title}
        accent={t.accent}
      />
    </div>
    <p class="sx-text af-text" data-rv style="--rvd: 0.07s">{t.text}</p>
    <div class="af-points" data-rv style="--rvd: 0.14s">
      <p class="af-note">{t.note}</p>
      <ul class="af-list">
        {t.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  <div class="af-media" data-rv="soft">
    <div class="px-frame af-frame af-frame--main">
      <img
        data-px
        src={contract.src}
        srcset={`${contractM.src} ${contractM.width}w, ${contract.src} ${contract.width}w`}
        sizes="(min-width: 1025px) 75vw, (min-width: 640px) 520px, 78vw"
        width={contract.width}
        height={contract.height}
        alt={t.contractAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="px-frame af-frame af-frame--extra" data-about-extra>
      <img
        data-px
        src={paperworkM.src}
        width={paperworkM.width}
        height={paperworkM.height}
        alt={t.paperworkAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .af {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 7vw, 40px);
    box-sizing: border-box;
    padding: clamp(48px, 13vw, 80px) max(var(--pad), calc((100% - 600px) / 2));
    background: var(--bg-card);
  }
  .af-body {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 7vw, 40px);
  }
  .af-points {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 4.6vw, 22px);
  }
  /* design: #7b8494 (3,9:1 na bieli — poniżej AA) */
  .af-note {
    margin: 0;
    font-size: clamp(14px, 3.8vw, 16px);
    line-height: 1.4;
    font-weight: 500;
    color: var(--muted);
  }
  .af-list {
    display: grid;
    gap: clamp(14px, 4vw, 18px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .af-list li {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2.8vw, 12px);
    padding-top: clamp(14px, 4vw, 18px);
    border-top: 1px solid rgba(var(--glow), 0.16);
    font-size: clamp(15px, 4.103vw, 18px);
    line-height: 1.34;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--navy);
  }
  .af-list li::before {
    content: "";
    width: clamp(20px, 5.6vw, 28px);
    height: 2px;
    background: var(--copper);
  }

  /* ── zdjęcia ── */
  .af-media {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(8px, 2.3vw, 12px);
    align-items: start;
    margin-top: clamp(4px, 1vw, 8px);
  }
  .af-frame {
    aspect-ratio: 4 / 5;
    background: var(--bg-photo);
  }
  .af-frame--main {
    margin-top: clamp(24px, 7vw, 40px);
  }
  .af-frame--main img {
    object-position: 38% 60%;
  }
  .af-frame--extra {
    border-radius: 0 0 clamp(36px, 10vw, 56px) 0;
  }
  .af-frame--extra img {
    object-position: 50% 55%;
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .af {
      display: grid;
      grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
      gap: 0;
      min-height: 780px;
      padding: 0;
    }
    .af-media {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      align-items: stretch;
      margin-top: 0;
    }
    .af-frame--main {
      flex: 1;
      aspect-ratio: auto;
      margin-top: 0;
      border-radius: 0 0 clamp(36px, 3.8vw, 56px) 0;
    }
    .af-frame--main img {
      object-position: 38% 58%;
    }
    .af-frame--extra {
      display: none;
    }
    .af-body {
      grid-column: 2;
      grid-row: 1;
      justify-content: center;
      gap: clamp(24px, 2.4vw, 34px);
      padding: clamp(56px, 5.5vw, 80px) var(--pad) clamp(56px, 5.5vw, 80px)
        clamp(40px, 4vw, 64px);
    }
    .af-body :global(.sx-head) {
      gap: clamp(24px, 2.4vw, 34px);
    }
    .af-body :global(.sx-h2) {
      font-size: clamp(28px, 2.7vw, 40px);
      line-height: 1.14;
    }
    .af-text {
      max-width: 52ch;
      font-size: clamp(15px, 1.15vw, 17px);
      line-height: 1.62;
    }
    .af-points {
      gap: clamp(24px, 2.4vw, 34px);
    }
    .af-note {
      font-size: clamp(13px, 1vw, 15px);
    }
    .af-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(20px, 2.2vw, 36px);
    }
    .af-list li {
      gap: clamp(12px, 1.2vw, 16px);
      padding-top: clamp(14px, 1.4vw, 20px);
      font-size: clamp(15px, 1.25vw, 18px);
    }
    .af-list li::before {
      width: clamp(20px, 2vw, 28px);
    }
  }
</style>
