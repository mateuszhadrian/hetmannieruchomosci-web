---
// Hero /o-nas/ (4.5, docs/analiza-o-nas.md §1, A6, A8, A10, A11).
// Telefon i tablet: zdjęcie od górnej krawędzi okna (POD przezroczystym
// paskiem), szklana karta z eyebrow i `h1` nasunięta na jego dół, akapit
// i pas liczb pod kartą. Desktop: pełne okno — zdjęcie + gradient, szklana
// karta (eyebrow, `h1`, akapit), pas liczb u dołu.
//
// `data-nav-hero` stoi na KADRZE zdjęcia: poniżej 1025 px kadr ma wysokość
// zdjęcia, od 1025 px wypełnia sekcję — pasek liczy z niego próg
// przemalowania i jest pełny, zanim wjedzie pod niego jasna część hero.
//
// Zdjęcie i `h1` to kandydaci LCP: `eager`, `fetchpriority`, preload na
// stronie, ŻADNEGO reveala. Parallax: `data-px="top"` (kadr od góry strony
// — przesunięcie 0 przy scrollu 0, bez przeskoku po wczytaniu modułu).
//
// Krycia szkła, gradientu i tekstu pochodzą z POMIARU kontrastu (analiza
// §10; axe zwraca dla tekstu nad obrazem „incomplete") — zmiana krycia,
// koloru tekstu albo zdjęcia wymaga ponownego pomiaru, razem z logo
// i kreskami menu paska nad zdjęciem.
import heroSmall from "@/assets/img/onas-hero-m.webp";
import hero from "@/assets/img/onas-hero.webp";
import { ABOUT_HERO_SMALL_BELOW_PX } from "./about-config";
import { ABOUT_COPY } from "./about-copy";

const t = ABOUT_COPY.hero;
---

<section class="ah" data-about="hero" data-about-hero>
  <div class="ah-media px-frame" data-nav-hero>
    <picture>
      <source
        media={`(max-width: ${ABOUT_HERO_SMALL_BELOW_PX - 1}px)`}
        srcset={heroSmall.src}
        width={heroSmall.width}
        height={heroSmall.height}
      />
      <img
        class="ah-photo"
        data-px="top"
        data-about-photo
        src={hero.src}
        width={hero.width}
        height={hero.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <span class="ah-shade" aria-hidden="true"></span>
  </div>

  <div class="ah-in">
    <div class="ah-text">
      <div class="ah-card">
        <p class="sx-eyebrow ah-eyebrow">{t.eyebrow}</p>
        <h1 class="ah-h1">{t.title} <span>{t.accent}</span></h1>
      </div>
      <p class="ah-lead">{t.lead}</p>
    </div>
  </div>

  <ul class="ah-stats" data-about-stats>
    {
      t.stats.map((s) => (
        <li>
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .ah {
    /* Szkło karty na telefonie: design ma srebro .39 — eyebrow nad dolną
       krawędzią zdjęcia wypadał wtedy 2,3:1. Jaśniejszy ton (kolor --bg)
       i wyższe krycie trzymają granat nad zdjęciem ORAZ miedzianą frazę
       nad jasnym tłem (srebro o tym kryciu dawało frazie poniżej 3:1).
       Desktop: granat .24 z designu przechodzi pomiar bez zmian. */
    --ah-glass: rgba(243, 242, 239, 0.8);
    --ah-glass-dark: rgba(9, 18, 36, 0.24);
    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: var(--svh, 100svh);
    padding-bottom: clamp(32px, 9vw, 56px);
    background: var(--bg);
  }

  /* ── zdjęcie ── */
  .ah-media {
    flex: none;
    height: clamp(300px, 88vw, 460px);
    border-radius: 0 0 0 clamp(64px, 18vw, 96px);
    background: var(--bg-photo);
  }
  .ah-photo {
    object-position: 50% 55%;
  }
  /* Telefon i tablet: przyciemnienie górnego pasa ZDJĘCIA pod paskiem —
     jasne kreski menu nad jasnym fragmentem kadru miały bez niego 1,9:1
     (z pomiaru; próg elementów interfejsu 3:1). Poniżej paska gaśnie. */
  .ah-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(9, 18, 36, 0.45) 0,
      rgba(9, 18, 36, 0.32) calc(var(--hdr-h) * 0.6),
      rgba(9, 18, 36, 0) calc(var(--hdr-h) + 48px)
    );
  }

  /* ── treść ── */
  .ah-in {
    position: relative;
    padding: 0 max(var(--pad), calc((100% - 600px) / 2));
  }
  .ah-card {
    box-sizing: border-box;
    margin-top: calc(-1 * clamp(56px, 16vw, 84px));
    padding: clamp(20px, 5.6vw, 30px);
    background: var(--ah-glass);
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
    border: 1px solid var(--glass-line);
  }
  .ah-eyebrow {
    margin-bottom: clamp(12px, 3.4vw, 16px);
    color: var(--navy);
  }
  .ah-eyebrow::before {
    background: var(--navy);
  }
  .ah-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 7.2vw, 42px);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--navy);
    text-wrap: pretty;
  }
  .ah-h1 span {
    color: var(--copper-dark);
  }
  .ah-lead {
    margin: 0;
    padding-top: clamp(20px, 5.6vw, 30px);
    max-width: 36ch;
    font-size: clamp(15px, 4.103vw, 20px);
    line-height: 1.55;
    color: var(--slate);
    text-wrap: pretty;
  }

  /* ── pas liczb (telefon: pod akapitem, dosunięty do dołu hero) ── */
  .ah-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(10px, 3vw, 20px);
    margin: auto 0 0;
    padding: clamp(28px, 8vw, 40px) max(var(--pad), calc((100% - 600px) / 2)) 0;
    list-style: none;
  }
  .ah-stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: clamp(12px, 3.4vw, 16px);
    border-top: 1px solid rgba(var(--glow), 0.16);
  }
  .ah-stats strong {
    font-size: clamp(22px, 6.4vw, 34px);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--navy);
  }
  .ah-stats span {
    font-family: var(--font-label);
    font-size: clamp(10px, 2.8vw, 12px);
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .ah {
      padding-bottom: 0;
      overflow: clip;
      color: var(--silver);
      background: var(--navy-deep);
    }
    .ah-media {
      position: absolute;
      inset: 0;
      height: auto;
      border-radius: 0;
      background: none;
    }
    .ah-shade {
      background: linear-gradient(
        90deg,
        rgba(9, 18, 36, 0.88) 0%,
        rgba(9, 18, 36, 0.66) 46%,
        rgba(9, 18, 36, 0.16) 100%
      );
    }
    .ah-in {
      flex: 1;
      display: flex;
      align-items: center;
      /* odstępy pionowe ograniczone wysokością okna (`svh`): na niskim
         oknie laptopa karta i pas liczb mieszczą się w pierwszym ekranie */
      padding: calc(var(--hdr-h) + min(clamp(24px, 2.6vw, 48px), 3svh))
        var(--pad) min(clamp(40px, 4vw, 64px), 4svh);
    }
    /* szkło nosi wspólne opakowanie (karta + akapit) */
    .ah-text {
      box-sizing: border-box;
      max-width: 720px;
      padding: min(clamp(32px, 3.4vw, 48px), 5svh) clamp(32px, 3.4vw, 48px);
      background: var(--ah-glass-dark);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(221, 221, 221, 0.14);
      border-radius: 3px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
    }
    .ah-card {
      margin: 0;
      padding: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border: 0;
    }
    .ah-eyebrow {
      margin-bottom: clamp(18px, 1.6vw, 24px);
      color: var(--copper-light);
    }
    .ah-eyebrow::before {
      background: var(--copper);
    }
    .ah-h1 {
      margin-bottom: clamp(20px, 1.8vw, 26px);
      font-size: min(clamp(38px, 4.1vw, 60px), 6.6svh);
      line-height: 1.08;
      color: var(--silver);
      text-shadow: 1px 2px 11px rgba(0, 0, 0, 0.35);
      text-wrap: balance;
    }
    .ah-h1 span {
      color: var(--copper);
    }
    .ah-lead {
      padding: 0;
      max-width: 48ch;
      font-size: clamp(16px, 1.25vw, 19px);
      line-height: 1.6;
      color: rgba(221, 221, 221, 0.88);
    }

    .ah-stats {
      position: relative;
      flex: none;
      column-gap: 0;
      margin: 0;
      padding: 0;
      border-top: 1px solid rgba(221, 221, 221, 0.16);
      background: rgba(9, 18, 36, 0.34);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
    }
    .ah-stats li {
      gap: 8px;
      padding: min(clamp(22px, 2.2vw, 34px), 3.2svh) clamp(24px, 2.6vw, 40px);
      border-top: 0;
    }
    .ah-stats li:first-child {
      padding-inline: var(--pad);
    }
    .ah-stats li:nth-child(2) {
      border-inline: 1px solid rgba(221, 221, 221, 0.16);
    }
    .ah-stats strong {
      font-size: clamp(28px, 2.5vw, 38px);
      color: #fff;
    }
    .ah-stats span {
      font-size: clamp(11px, 0.85vw, 13px);
      letter-spacing: 0.14em;
      color: rgba(221, 221, 221, 0.72);
    }
  }
</style>
