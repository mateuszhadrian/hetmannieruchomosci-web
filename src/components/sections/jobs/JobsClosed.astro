---
// /praca/ przy wyłączonym przełączniku SHOW_PRACA (docs/analiza-
// formularze-b.md Q7): adres zostaje (stare linki nie kończą się 404), ale
// strona nie ma formularza — krótka informacja i przejście do kontaktu.
// Strona jest wtedy poza sitemapą i ma `noindex` (praca.astro), a funkcja
// formularzy odrzuca `form=praca`.
import { CONTACT_PATH } from "@/lib/routes";
import { JOBS_COPY } from "./jobs-copy";

const t = JOBS_COPY.closed;
---

<div class="jc" data-jobs-closed>
  <h1 class="jc-h1">{t.heading}</h1>
  <p class="sx-text">{t.text}</p>
  <a class="sx-btn" href={CONTACT_PATH}>{t.cta}</a>
</div>

<style>
  .jc {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(16px, 4.4vw, 24px);
    min-height: 50vh;
    padding: calc(var(--hdr-h) + clamp(24px, 6.5vw, 40px))
      max(var(--pad), calc((100% - 600px) / 2)) 0;
  }
  .jc-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 7.2vw, 42px);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--navy);
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .jc {
      padding: 0;
    }
    .jc-h1 {
      font-size: clamp(34px, 3.6vw, 54px);
      line-height: 1.1;
    }
  }
</style>
