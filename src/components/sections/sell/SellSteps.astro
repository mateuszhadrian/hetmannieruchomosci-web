---
// Trzy kroki /sprzedaj-z-nami/ (5A, docs/analiza-formularze-a.md §1.2):
// telefon i tablet — białe wiersze z miedzianą kreską z lewej; desktop —
// trzy karty z kreską u góry. Numery 01–03 to licznik CSS (dekoracja;
// kolejność niesie <ol>). Reveale na wierszach (bloki nieinteraktywne),
// kaskada na desktopie przez --rvd.
import { SELL_COPY as t } from "./sell-copy";
---

<div class="ss" data-sell-steps>
  <ol class="ss-list">
    {
      t.steps.map((step, i) => (
        <li class="ss-step" data-rv style={`--rvd: ${(i * 0.07).toFixed(2)}s`}>
          <div class="ss-body">
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .ss {
    box-sizing: border-box;
    padding: clamp(28px, 8vw, 40px) max(var(--pad), calc((100% - 600px) / 2));
  }
  .ss-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: krok;
  }
  .ss-step {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: clamp(14px, 4vw, 18px);
    background: var(--bg-card);
    border-left: 2px solid var(--copper);
    counter-increment: krok;
  }
  /* drobny numer: odcień miedzi trzymający kontrast małego druku */
  .ss-step::before {
    content: counter(krok, decimal-leading-zero);
    flex: none;
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--copper-text);
  }
  .ss-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ss-step h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(16px, 4.4vw, 18px);
    line-height: 1.3;
    font-weight: 600;
    color: var(--navy);
  }
  .ss-step p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--slate);
    text-wrap: pretty;
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .ss {
      padding: clamp(48px, 4.6vw, 72px) var(--pad) clamp(56px, 5.4vw, 84px);
    }
    .ss-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(20px, 2vw, 32px);
      max-width: var(--col);
      margin-inline: auto;
    }
    .ss-step {
      flex-direction: column;
      align-items: stretch;
      gap: clamp(8px, 0.9vw, 12px);
      padding: clamp(24px, 2.4vw, 34px) clamp(22px, 2.2vw, 30px)
        clamp(26px, 2.6vw, 36px);
      border-left: 0;
      border-top: 2px solid var(--copper);
    }
    .ss-step::before {
      font-size: clamp(28px, 2.8vw, 36px);
      line-height: 1;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: var(--copper);
    }
    .ss-body {
      display: contents;
    }
    .ss-step h2 {
      font-size: clamp(19px, 1.6vw, 24px);
      line-height: 1.2;
    }
    .ss-step p {
      font-size: clamp(15px, 1.15vw, 17px);
      line-height: 1.55;
    }
  }
</style>
