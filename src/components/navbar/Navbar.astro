---
// Chrome globalny — pasek FIXED + menu mobilne jako bottom sheet na
// szkielecie scripts/overlay.ts (focus-trap, Esc, scrim, swipe-down,
// blokada scrolla — mechanika wspólna, NIE ruszać).
//
// Wygląd docelowy (Etap 4.1, docs/analiza-chrome.md): logo w dwóch
// wariantach, sześć pozycji z efektem liter przy hover (czysty CSS, za
// bramką prefers-reduced-motion), telefon przez slot antyscrapingowy,
// wariant strony głównej przemalowywany POZYCJĄ SCROLLA.
//
// Stany paska:
//  [data-scroll-nav] — wariant „/" (SSR, tylko HOME_PATH): pasek startuje
//    przezroczysty nad hero; skrypt pisze zmienne --nav-* na nagłówku,
//    CSS je konsumuje. Kontrakt = PRÓG SCROLLA z wysokości okna (hero
//    z 4.4 jest pełnoekranowe), nie selektor sekcji hero.
//  [data-hero] — SSR razem z data-scroll-nav (stan przezroczysty bez
//    migotania przed startem skryptu); bez JS <noscript> przywraca tło.
//  [data-solid] — pasek „pełny": na „/" po dojechaniu przemalowania do
//    końca, na pozostałych trasach zaraz po ruszeniu scrolla.
//  [data-open] — otwarty sheet.
import { mainNavItems } from "@/i18n/nav";
import { CONTACT_PATH, HOME_PATH } from "@/lib/routes";
import logoColor from "@/assets/logo/logo-color.webp";
import logoSilver from "@/assets/logo/logo-silver.webp";

// Normalizacja ukośnika — w dev Astro.url.pathname bywa bez końcowego "/".
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

/** Wariant przezroczysty nad hero — WYŁĄCZNIE strona główna. */
const isHome = currentPath === HOME_PATH;

/** Pozycja jest bieżąca także dla adresów POD nią (listy i detale ofert
 *  pod /oferty/). */
const isCurrent = (href: string) =>
  href === HOME_PATH ? currentPath === href : currentPath.startsWith(href);

/** Efekt liter (design: .hn-ch z dwiema kopiami znaku, spacja = .hn-sp).
 *  Generowane tu, nie wpisywane ręcznie — jedna tablica pozycji
 *  (SHOW_PRACA, zmiana etykiety) bez przepisywania spanów. `i` daje
 *  kaskadę opóźnień w CSS (--i). */
const letters = (label: string) =>
  [...label].map((ch, i) => ({ ch, i, space: ch === " " }));

const t = {
  nav: "Menu główne",
  mobileNav: "Menu główne",
  openMenu: "Otwórz menu",
  closeMenu: "Zamknij menu",
  menu: "Menu",
  call: "Zadzwoń",
  home: "Hetman Nieruchomości — strona główna",
  brand: "Hetman Nieruchomości",
};
---

<header
  class="hdr"
  data-nav
  data-scroll-nav={isHome ? "" : undefined}
  data-hero={isHome ? "" : undefined}
>
  {
    /* scrim nad hero (design: gradient 190 px) — tylko wariant „/";
       gaśnie razem z przemalowaniem */
    isHome && <span class="hdr-scrim" aria-hidden="true" />
  }
  {/* szklane tło paska (design: półprzezroczysta szarość + blur) */}
  <span class="hdr-bg" aria-hidden="true"></span>

  <a class="hdr-logo" href={HOME_PATH} aria-label={t.home}>
    <img
      class="hdr-logo-dark"
      src={logoColor.src}
      width={logoColor.width}
      height={logoColor.height}
      alt={t.brand}
      decoding="async"
    />
    {
      /* logo jasne nad hero — crossfade z ciemnym pozycją scrolla */
      isHome && (
        <img
          class="hdr-logo-light"
          src={logoSilver.src}
          width={logoSilver.width}
          height={logoSilver.height}
          alt=""
          aria-hidden="true"
          decoding="async"
        />
      )
    }
  </a>

  <nav class="hdr-nav" aria-label={t.nav}>
    {
      mainNavItems.map((item) => (
        <a
          class="nav-link"
          href={item.href}
          aria-label={item.label}
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {letters(item.label).map((l) =>
            l.space ? (
              <span class="hn-sp" aria-hidden="true" />
            ) : (
              <span class="hn-ch" aria-hidden="true" style={`--i:${l.i}`}>
                <span>{l.ch}</span>
                <span>{l.ch}</span>
              </span>
            ),
          )}
        </a>
      ))
    }
    {
      /* numer i href składane w JS (antyscraping — lib/contact-details);
         bez JS pozycja zostaje ukryta */
    }
    <a class="hdr-tel" data-tel href={CONTACT_PATH} hidden>Telefon</a>
  </nav>

  <button
    class="mbtn"
    type="button"
    data-burger
    aria-expanded="false"
    aria-controls="nav-sheet"
    aria-label={t.openMenu}
    data-open-label={t.openMenu}
    data-close-label={t.closeMenu}
  >
    <i aria-hidden="true"><b></b><b></b></i>
  </button>
</header>
{
  /* Bez JS wariant „/" nie ma kto przemalować — przywracamy pełny pasek
     (selektor trafia wyłącznie na „/"). !important, bo reguły komponentu
     są scope'owane atrybutem (wyższa specyficzność) i inaczej wygrałyby
     domyślne wartości stanu przezroczystego. */
}
<noscript>
  <style is:inline>
    .hdr[data-hero] {
      --nav-e: 1 !important;
      --nav-c: #1c1b19 !important;
      --nav-ch: #183a6b !important;
      --nav-sh: 0 !important;
      --nav-bar: #183a6b !important;
    }
  </style>
</noscript>

{/* Bottom sheet menu — kontrakt overlay.ts (portalowany do <body>). */}
<div
  class="sheet-ov"
  id="nav-sheet"
  data-overlay
  data-overlay-kind="sheet"
  role="dialog"
  aria-modal="true"
  aria-label={t.menu}
  hidden
>
  <div class="sheet" data-overlay-panel tabindex="-1">
    <div class="sheet-in" data-overlay-scroll>
      <div class="sheet-head" data-overlay-drag>
        <span class="sheet-grab" aria-hidden="true"></span>
      </div>
      <nav aria-label={t.mobileNav}>
        {
          mainNavItems.map((item) => (
            <a
              class="m-link"
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.sheetLabel ?? item.label}
            </a>
          ))
        }
      </nav>
      <div class="sheet-call">
        <a data-tel href={CONTACT_PATH} hidden>
          <b>{t.call}</b>
          <span data-slot>Telefon</span>
        </a>
        <img
          class="sheet-logo"
          src={logoColor.src}
          width={logoColor.width}
          height={logoColor.height}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>

<style>
  /* ── pasek ── */
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--hdr-h);
    padding-inline: var(--pad);
    box-sizing: border-box;
  }

  /* Wariant „/" — zmienne pisane przez skrypt co klatkę (e = 0 nad hero,
     1 po przemalowaniu). Wartości startowe = stan przezroczysty. */
  .hdr[data-hero] {
    --nav-e: 0;
    --nav-c: rgba(255, 255, 255, 0.88);
    --nav-ch: rgba(255, 255, 255, 0.88);
    --nav-sh: 0.35;
    --nav-bar: var(--silver);
  }

  /* Szklane tło: widoczne ZAWSZE poza wariantem „/", gdzie wjeżdża
     pozycją scrolla. Bez przejścia czasowego — stan liczy pętla rAF. */
  .hdr-bg {
    position: absolute;
    inset: 0;
    background: var(--glass);
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
    border-bottom: 1px solid var(--glass-line);
  }
  .hdr[data-hero] .hdr-bg {
    opacity: var(--nav-e);
  }
  /* scrim nad hero: gradient wyższy niż pasek (design: 190 px) */
  .hdr-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 190px;
    background: linear-gradient(
      to bottom,
      rgba(12, 11, 10, 0.55),
      rgba(12, 11, 10, 0.22) 46%,
      rgba(12, 11, 10, 0)
    );
    opacity: calc(1 - var(--nav-e, 0));
    pointer-events: none;
  }

  .hdr-logo {
    position: relative;
    display: block;
    flex: none;
    height: clamp(37.3px, 10.769vw, 56px);
  }
  .hdr-logo img {
    display: block;
    width: auto;
    height: 100%;
  }
  .hdr-logo-light {
    position: absolute;
    left: 0;
    top: 0;
    opacity: calc(1 - var(--nav-e, 0));
    filter: drop-shadow(0 1px 6px rgba(0, 0, 0, 0.35));
  }
  .hdr[data-hero] .hdr-logo-dark {
    opacity: var(--nav-e);
  }
  .hdr-logo:hover {
    opacity: 0.8;
  }
  .hdr-logo:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 4px;
  }

  .hdr-nav {
    display: none;
  }

  /* ── przycisk menu (mobile): 2 kreski → X ── */
  .mbtn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    background: none;
    border: none;
    color: var(--navy);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* nad hero kreski jasne, przemalowywane razem z tłem */
  .hdr[data-hero] .mbtn {
    color: var(--nav-bar);
  }
  .mbtn:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
  }
  .mbtn i {
    position: relative;
    display: block;
    width: 38px;
    height: 13px;
  }
  .mbtn i b {
    position: absolute;
    left: 0;
    width: 38px;
    height: 2.5px;
    background: currentColor;
    transition: transform 0.34s cubic-bezier(0.3, 0, 0.2, 1);
  }
  .mbtn i b:nth-child(1) {
    top: 0;
  }
  .mbtn i b:nth-child(2) {
    top: 10.5px;
  }
  .hdr[data-open] .mbtn i b:nth-child(1) {
    transform: translateY(5.25px) rotate(45deg);
  }
  .hdr[data-open] .mbtn i b:nth-child(2) {
    transform: translateY(-5.25px) rotate(-45deg);
  }

  /* ── bottom sheet menu ── */
  .sheet-ov {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-end;
    background: rgba(8, 16, 30, 0.26);
    opacity: 0;
    transition: opacity 0.34s ease;
  }
  .sheet-ov[hidden] {
    display: none;
  }
  .sheet-ov.is-open {
    opacity: 1;
  }

  .sheet {
    position: relative;
    width: 100%;
    border-radius: 18px 18px 0 0;
    overflow: hidden;
    /* Design: szkło .39 + blur. Podkład gęstszy (decyzja 4.1, R7):
       sheet otwiera się też nad ciemnym hero „/", a granatowy tekst
       na szkle nie trzyma kontrastu AA. */
    background: rgba(243, 242, 239, 0.96);
    -webkit-backdrop-filter: blur(22px);
    backdrop-filter: blur(22px);
    box-shadow: 0 -18px 44px rgba(0, 0, 0, 0.4);
    /* grab + pierwszy link zawsze widoczne — zapas na notch (safe-area)
       i dynamiczny pasek przeglądarki (svh). */
    max-height: 92vh;
    max-height: min(92svh, calc(100svh - env(safe-area-inset-top, 0px) - 20px));
    display: flex;
    transform: translateY(101%);
    transition: transform 0.42s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .sheet-ov.is-open .sheet {
    transform: none;
  }
  /* Panel bywa programowo fokusowany przy otwarciu dotykiem (tabindex=-1) —
     bez pierścienia; to kontener, nie kontrolka. */
  .sheet:focus {
    outline: none;
  }
  .sheet-in {
    position: relative;
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
    padding: 0 var(--pad) calc(30px + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }
  .sheet-head {
    /* strefa chwytu gestu swipe-down — pełna szerokość, powiększona;
       touch-action:none blokuje natywny scroll podczas gestu. */
    padding: 9px 0 0;
    touch-action: none;
    cursor: grab;
  }
  .sheet-head:active {
    cursor: grabbing;
  }
  .sheet-grab {
    display: block;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: rgba(24, 58, 107, 0.26);
    margin: 0 auto 8px;
  }
  .sheet-in nav {
    display: flex;
    flex-direction: column;
    padding-top: clamp(8px, 2.3vw, 16px);
  }
  .m-link {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(21px, 6.154vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid rgba(24, 58, 107, 0.14);
    -webkit-tap-highlight-color: transparent;
  }
  .sheet-in nav > .m-link:last-child {
    border-bottom: none;
  }
  .m-link[aria-current="page"] {
    font-weight: 600;
  }
  .m-link:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 2px;
  }

  /* stopka sheeta: telefon + znak */
  .sheet-call {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    min-height: 58px;
    margin-top: clamp(6px, 2.051vw, 10px);
    padding-top: clamp(12px, 3.59vw, 16px);
    border-top: 1px solid rgba(24, 58, 107, 0.2);
  }
  .sheet-call a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--navy);
  }
  .sheet-call a[hidden] {
    display: none;
  }
  .sheet-call a b {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sheet-call a span {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(18px, 5.128vw, 24px);
    letter-spacing: 0.01em;
  }
  .sheet-logo {
    display: block;
    width: auto;
    height: clamp(16px, 4.872vw, 24px);
    margin: 0 0 clamp(10px, 3.077vw, 14px) auto;
    opacity: 0.85;
  }

  /* ════ DESKTOP ≥1025 (para: NAV_DESKTOP_MIN_PX w nav-config.ts) ════ */
  @media (min-width: 1025px) {
    .hdr {
      padding-inline: var(--g);
    }
    .hdr-logo {
      height: 42px;
    }

    .hdr-nav {
      position: relative;
      display: flex;
      align-items: center;
      gap: clamp(22px, 2.36vw, 34px);
    }

    .nav-link {
      position: relative;
      isolation: isolate;
      display: inline-flex;
      align-items: baseline;
      padding: 10px 0;
      white-space: nowrap;
      text-decoration: none;
      font-family: var(--font-label);
      font-weight: 500;
      font-size: clamp(12px, 1.02vw, 13px);
      line-height: 1;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink);
      transition: color 0.35s ease;
    }
    /* podkreślenie wjeżdżające od lewej; bieżąca strona = miedź */
    .nav-link::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0.16em;
      bottom: 3px;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .nav-link:hover,
    .nav-link:focus-visible,
    .nav-link[aria-current="page"] {
      color: var(--navy);
    }
    .nav-link:hover::after,
    .nav-link:focus-visible::after,
    .nav-link[aria-current="page"]::after {
      transform: scaleX(1);
    }
    .nav-link[aria-current="page"]::after {
      background: var(--copper);
    }
    .nav-link:focus-visible {
      outline: 2px solid var(--navy);
      outline-offset: 4px;
    }

    /* litery: każda w kieszeni (clip-path), druga kopia pod spodem */
    .hn-ch {
      position: relative;
      display: inline-block;
      clip-path: inset(0);
      line-height: 1;
      vertical-align: baseline;
    }
    .hn-ch > span {
      display: block;
    }
    .hn-ch > span:nth-child(2) {
      position: absolute;
      top: 100%;
      left: 0;
    }
    .hn-sp {
      display: inline-block;
      width: 0.3em;
    }
    /* podjazd liter — ruch wyłącznie bez prefers-reduced-motion
       (bramka ruchu; przy reduce zostaje kolor i podkreślenie) */
    @media (prefers-reduced-motion: no-preference) {
      .hn-ch > span {
        transition: transform 0.42s cubic-bezier(0.76, 0, 0.24, 1);
        transition-delay: calc(var(--i, 0) * 0.028s);
      }
      .nav-link:hover .hn-ch > span,
      .nav-link:focus-visible .hn-ch > span {
        transform: translateY(-100%);
      }
    }

    /* wariant „/": kolory linków z pętli rAF, cień tekstu i halo gasną */
    .hdr[data-hero] .nav-link {
      color: var(--nav-c);
      text-shadow: 0 1px 6px rgba(0, 0, 0, var(--nav-sh));
    }
    .hdr[data-hero] .nav-link:hover,
    .hdr[data-hero] .nav-link:focus-visible {
      color: var(--nav-ch);
    }
    .hdr[data-hero] .nav-link::after {
      background: var(--nav-c);
    }
    .hdr[data-hero] .nav-link[aria-current="page"]::after {
      background: var(--copper);
    }
    .hdr[data-hero] .nav-link::before {
      content: "";
      position: absolute;
      inset: -16px -20px;
      z-index: -1;
      border-radius: 40px;
      background: radial-gradient(
        closest-side,
        rgba(255, 255, 255, calc(0.32 * (1 - var(--nav-e, 0)))) 0%,
        rgba(0, 0, 0, 0) 75%
      );
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    .hdr[data-hero] .nav-link:hover::before,
    .hdr[data-hero] .nav-link:focus-visible::before {
      opacity: 1;
    }

    .hdr-tel {
      display: flex;
      align-items: center;
      padding: 12px 22px;
      border-radius: 999px;
      background: var(--navy);
      color: #fff;
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 14px;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
    }
    .hdr-tel[hidden] {
      display: none;
    }
    .hdr-tel:hover {
      opacity: 0.88;
    }
    .hdr-tel:focus-visible {
      outline: 2px solid var(--navy);
      outline-offset: 3px;
    }
    .hdr[data-hero] .hdr-tel {
      box-shadow: 0 2px 14px rgba(0, 0, 0, calc(0.22 * (1 - var(--nav-e, 0))));
    }

    .mbtn,
    .sheet-ov {
      display: none;
    }
  }

  /* ── reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .mbtn i b,
    .sheet-ov,
    .sheet,
    .nav-link,
    .nav-link::after,
    .nav-link::before {
      transition: none;
    }
  }
</style>

<script>
  import "@/scripts/overlay";
  import { fillContactSlots } from "@/lib/contact-details";
  import {
    NAV_DESKTOP_MIN_PX,
    NAV_HOME_EPSILON,
    NAV_HOME_FADE_START,
    NAV_HOME_LERP,
    NAV_SOLID_FALLBACK_PX,
  } from "@/components/navbar/nav-config";

  const hdr = document.querySelector<HTMLElement>("[data-nav]");
  if (hdr) {
    const burger = hdr.querySelector<HTMLButtonElement>("[data-burger]")!;
    const SHEET_ID = "nav-sheet";
    const desktopMQ = matchMedia(`(min-width:${NAV_DESKTOP_MIN_PX}px)`);
    const reduceMQ = matchMedia("(prefers-reduced-motion: reduce)");
    /** Wariant „/" (SSR): przemalowanie pozycją scrolla. */
    const home = hdr.hasAttribute("data-scroll-nav");

    // telefon w pasku, sheecie i stopce (antyscraping — lib/contact-details)
    fillContactSlots();

    // Wysokość paska jako zmienna globalna — statyczny fallback siedzi
    // w global.css (:root), JS doprecyzowuje pomiarem.
    const setHdrH = () =>
      document.documentElement.style.setProperty(
        "--hdr-h",
        `${Math.round(hdr.getBoundingClientRect().height)}px`,
      );
    new ResizeObserver(setHdrH).observe(hdr);
    setHdrH();

    // ── stan paska ──
    // Sheet menu blokuje scroll przez `body{position:fixed;top:-scrollY}`
    // (overlay.ts) — to ZERUJE window.scrollY i odpala zdarzenie `scroll`,
    // więc bez tej flagi stan paska przeliczałby się na pozycji 0 dokładnie
    // w chwili otwarcia menu. Deklaracja MUSI stać przed onScroll (TDZ).
    let sheetOpen = false;
    // KAŻDA nakładka blokuje scroll przez `body{position:fixed}` —
    // zamrażamy stan paska na czas otwartej nakładki.
    const frozen = () => sheetOpen || document.body.style.position === "fixed";
    function setSolid(s: boolean) {
      hdr!.toggleAttribute("data-solid", s);
    }

    // ── wariant „/": przemalowanie pozycją scrolla (design site.js §4) ──
    // Postęp e ∈ [0, 1] ze smoothstep; start = 0,32 × h, koniec = h − pasek,
    // h = wysokość OKNA (próg scrolla, nie selektor hero). Pętla rAF
    // dociąga wartość (Safari dostarcza `scroll` rzadziej, niż przewija —
    // scroll.md); przy reduce — skok. Zapis = kilka zmiennych CSS na
    // nagłówku, nie style inline per link.
    const WHITE = [255, 255, 255];
    const INK = [28, 27, 25]; // --ink
    const NAVY = [24, 58, 107]; // --navy
    const SILVER = [221, 221, 221]; // --silver
    const mix = (a: number[], b: number[], e: number) =>
      a.map((v, i) => Math.round(v + (b[i] - v) * e));
    const rgba = (c: number[], a: number) =>
      `rgba(${c.join(",")},${a.toFixed(3)})`;
    let target = 0;
    let current = 0;
    let raf = 0;

    function progress(): number {
      const h = window.innerHeight;
      const navH = hdr!.offsetHeight || 96;
      const start = h * NAV_HOME_FADE_START;
      const end = Math.max(start + 1, h - navH);
      const p = Math.min(
        1,
        Math.max(0, (window.scrollY - start) / (end - start)),
      );
      return p * p * (3 - 2 * p);
    }
    function paint(e: number) {
      const st = hdr!.style;
      const base = mix(WHITE, INK, e);
      const alpha = 0.88 + 0.12 * e;
      st.setProperty("--nav-e", e.toFixed(3));
      st.setProperty("--nav-c", rgba(base, alpha));
      st.setProperty("--nav-ch", rgba(mix(base, NAVY, e), alpha));
      st.setProperty("--nav-sh", (0.35 * (1 - e)).toFixed(3));
      st.setProperty("--nav-bar", `rgb(${mix(SILVER, NAVY, e).join(",")})`);
      setSolid(e >= 1 - NAV_HOME_EPSILON);
    }
    function tick() {
      raf = 0;
      const d = target - current;
      if (reduceMQ.matches || Math.abs(d) < NAV_HOME_EPSILON) {
        current = target;
      } else {
        current += d * NAV_HOME_LERP;
        raf = requestAnimationFrame(tick);
      }
      paint(current);
    }

    function onScroll() {
      if (frozen()) return;
      if (home) {
        target = progress();
        if (!raf) raf = requestAnimationFrame(tick);
      } else {
        setSolid(window.scrollY > NAV_SOLID_FALLBACK_PX);
      }
    }
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    if (home) {
      // start bez dociągania — przeładowanie w środku strony od razu
      // w stanie docelowym
      current = target = progress();
      paint(current);
    } else {
      onScroll();
    }

    // ── menu mobilne: bottom sheet przez overlay.ts ──
    let isOpen = false;
    function setMenuState(open: boolean) {
      isOpen = open;
      // podnosimy flagę PRZED blokadą scrolla i zdejmujemy PO jej zdjęciu,
      // żeby żadne z dwóch zdarzeń `scroll` wywołanych przez overlay.ts nie
      // przeliczyło progu na pozycji 0
      sheetOpen = open;
      hdr!.toggleAttribute("data-open", open);
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute(
        "aria-label",
        (open ? burger.dataset.closeLabel : burger.dataset.openLabel) || "",
      );
    }
    burger.addEventListener("click", () => {
      if (isOpen) {
        window.overlay?.close(SHEET_ID);
      } else {
        setMenuState(true);
        // onClose łapie KAŻDĄ drogę zamknięcia (Esc, scrim, swipe, link)
        window.overlay?.open(SHEET_ID, {
          onClose: () => setMenuState(false),
        });
      }
    });

    // przejście na desktop: menu mobilne znika, więc sheet się domyka
    // (spójny stan nakładek i blokady scrolla)
    desktopMQ.addEventListener("change", (e) => {
      if (e.matches && isOpen) window.overlay?.close(SHEET_ID);
      onScroll();
    });
  }
</script>
