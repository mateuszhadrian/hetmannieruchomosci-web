---
// Ramka formularza — wspólna dla wszystkich formularzy serwisu (Etap 5A,
// docs/analiza-formularze-a.md): pola ze slotu, blok końcowy w kolejności
// zgoda → nota → przycisk (elementy kolumny flex z `gap`, nie obszary
// gridu), pułapka na boty, kontener Turnstile, komunikat błędu wysyłki
// i ekran potwierdzenia W MIEJSCU formularza. Mechanika: form-ui.ts.
//
// Bez JS formularz renderuje się kompletny (`method`/`action`, natywna
// walidacja z `required`), ale wysyłka wymaga JavaScriptu (token
// Turnstile) — mówi to `<noscript>`; endpoint odsyła taki POST z powrotem.
//
// Zgoda marketingowa: opcjonalna, odznaczona, bez gwiazdki — formularz
// wysyła się bez niej. Nota informuje, checkbox zbiera zgodę: nie łączyć.
// Formularz rekrutacyjny podmienia ją propem `consent` na zgodę na
// przyszłe rekrutacje (zgody marketingowej nie ma tam wcale).
// Kontakt w komunikatach przez slot antyscrapingowy: telefon
// (`a[data-tel]`) albo — `contact="mail"` — adres biura (`a[data-mail]`).
//
// `tone="dark"` — formularz na ciemnym tle (zapytanie przy ofercie):
// klasa `fm-frame--dark` przestawia kolory w forms.css, markup ten sam.
import { MARKETING_CONSENT, type ActiveFormKind } from "@/lib/contact-form";
import { POLICY_PATH } from "@/lib/routes";
import { FORM_ENDPOINT } from "./form-config";
import FormMail from "./FormMail.astro";
import FormTel from "./FormTel.astro";
import { FORM_COPY, RESPONSE_TIME, type FormFrameCopy } from "./forms-copy";
import "./forms.css";

interface Props {
  kind: ActiveFormKind;
  /** Prefiks id elementów (unikalny per formularz na stronie). */
  idPrefix: string;
  copy: FormFrameCopy;
  tone?: "light" | "dark";
  /** Id nagłówka, który nazywa formularz (gdy formularz nie ma własnego). */
  labelledby?: string;
  /** Selektor DRUGIEGO elementu przyklejonego pod paskiem (np. kotwice
   *  detalu oferty) — skrypt dosuwa pod niego błędne pole i potwierdzenie. */
  under?: string;
  /** Jedyny checkbox bloku końcowego (zawsze opcjonalny): `name` pola
   *  i brzmienie. Domyślnie zgoda marketingowa. */
  consent?: { name: string; text: string };
  /** Slot kontaktu w komunikacie błędu wysyłki i w potwierdzeniu. */
  contact?: "tel" | "mail";
  /** Formularz z polem pliku: `multipart/form-data` (wysyłka bez JS). */
  enctype?: "multipart/form-data";
}
const {
  kind,
  idPrefix,
  copy,
  tone = "light",
  labelledby,
  under,
  consent = { name: "marketing", text: MARKETING_CONSENT },
  contact = "tel",
  enctype,
} = Astro.props;
---

<div
  class:list={["fm-frame", tone === "dark" && "fm-frame--dark"]}
  data-form-frame
  data-state="form"
  data-form-under={under}
>
  <form
    class="fm-form"
    data-form={kind}
    method="post"
    action={FORM_ENDPOINT}
    enctype={enctype}
    aria-labelledby={labelledby}
  >
    <input type="hidden" name="form" value={kind} />
    <slot />

    <label class="fm-consent">
      <input type="checkbox" name={consent.name} value="1" />
      <span>{consent.text}</span>
    </label>

    <p class="fm-note">
      {copy.purpose}
      {FORM_COPY.noteTail}
      <a href={POLICY_PATH}>{FORM_COPY.policyLink}</a>.
    </p>

    {
      /* pułapka na boty: readonly (autofill nie wypełnia pól readonly —
         focus zdejmuje atrybut), poza kolejnością Tab, ukryta wizualnie
         (NIE display:none) */
    }
    <div class="fm-hp" aria-hidden="true">
      <label for={`${idPrefix}-firma`}>{FORM_COPY.honeypot}</label>
      <input
        id={`${idPrefix}-firma`}
        name="firma"
        type="text"
        tabindex="-1"
        autocomplete="off"
        readonly
      />
    </div>

    <div class="fm-ts" data-form-ts></div>

    <noscript><p class="fm-nojs">{FORM_COPY.noJs}</p></noscript>

    <p class="fm-srv" data-form-error role="alert" hidden>
      {copy.serverError}
      {contact === "mail" ? <FormMail /> : <FormTel />}
    </p>

    <button
      class="sx-btn fm-send"
      type="submit"
      data-form-submit
      data-send={copy.submit}
      data-sending={FORM_COPY.sending}
      ><span data-label>{copy.submit}</span></button
    >
    <slot name="after" />
  </form>

  <div class="fm-done" data-form-done hidden>
    <h3 class="fm-done-h" tabindex="-1" data-done-h>{copy.doneHeading}</h3>
    <p class="fm-done-p">
      {copy.doneBefore}
      {!copy.doneUntimed && <strong>{RESPONSE_TIME}</strong>}{copy.doneAfter}
      {
        /* numer telefonu tylko tam, gdzie potwierdzenie ma zdanie, które
           do niego prowadzi */
        copy.doneCall && (
          <>
            {`${copy.doneCall} `}
            {contact === "mail" ? <FormMail /> : <FormTel />}{" "}
          </>
        )
      }
    </p>
    <button class="fm-again" type="button" data-form-again>{copy.again}</button>
  </div>
</div>
