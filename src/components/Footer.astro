---
// Stopka — granat z designu, wspólna dla wszystkich tras (eksport ma tę
// samą stopkę na każdej podstronie). Telefon i e-mail przez sloty
// antyscrapingowe (lib/contact-details). Firma nie prowadzi profili
// w mediach społecznościowych — stopka nie ma sekcji social.
//
// Etap 4.1 (docs/analiza-chrome.md): układ per breakpoint wg designu
// (mobile: logo + telefon, hasło, przyciski Zadzwoń/Napisz, pastylki mapy
// strony, dane; desktop: jeden rząd z hasłem, telefonem i CTA, linki
// wersalikami, dane w wierszu). ROZJAZD R1: design nie ma adresu siedziby
// ani e-maila — obowiązuje baza wiedzy: wiersz „Firma:" niesie nazwę
// rejestrową, siedzibę, NIP i REGON; wiersz „E-mail:" ze slotem `biuro`.
// „Biuro:" (adres poznański z linkiem do map) zostaje — to miejsce
// spotkań; etykiety rozróżniają oba adresy.
import { footerNavItems } from "@/i18n/nav";
import { CONTACT_PATH, HOME_PATH, POLICY_PATH } from "@/lib/routes";
import { BUSINESS } from "@/lib/jsonld";
import { BUILD_NOW } from "@/lib/offers/data";
import logo from "@/assets/logo/logo-silver.webp";

// Link do map otwierany po KLIKNIĘCIU — zero żądań do podmiotów trzecich
// przy wejściu na stronę.
const MAPS_URL =
  "https://maps.google.com/?q=" +
  encodeURIComponent(
    `${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.locality}`,
  );
const NIP = BUSINESS.vatID.replace(/\D/g, "");
// Rok © z jednego „teraz" projektu (BUILD_NOW) — zrzuty wizualne nie
// zmieniają się z kalendarzem.
const year = BUILD_NOW.getFullYear();

const t = {
  home: "Hetman Nieruchomości — strona główna",
  brand: "Hetman Nieruchomości",
  // PLACEHOLDER (U9): hasło z designu, baza wiedzy go nie potwierdza.
  motto: "Nieruchomości, dokumenty i sprawy prawne — w jednym miejscu.",
  // PLACEHOLDER (U9): brzmienie CTA z designu.
  cta: "Skontaktuj się z nami",
  call: "Zadzwoń",
  write: "Napisz",
  sitemap: "Mapa strony",
  office: "Biuro:",
  hours: "Godziny:",
  // Godziny potwierdzone w bazie wiedzy (part1 §1) — nie placeholder.
  hoursValue: "pon.–pt. 11:00–17:00, inne terminy po ustaleniu",
  mail: "E-mail:",
  company: "Firma:",
  policy: "Polityka prywatności",
  // PLACEHOLDER (U9): pisownia nazwy w © (design „Hetman", rejestr „HETMAN").
  copyright: `© ${year} Hetman Nieruchomości`,
  // PLACEHOLDER (U9): linia wykonawcy — brzmienie i adres do potwierdzenia.
  madeBy: "Realizacja:",
  madeByName: "hadrianm",
  madeBySuffix: " — pracownia stron i aplikacji",
};
---

<footer class="ft">
  <div class="ft-main">
    <div class="ft-top">
      <a class="ft-logo" href={HOME_PATH} aria-label={t.home}>
        <img
          src={logo.src}
          width={logo.width}
          height={logo.height}
          alt={t.brand}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="ft-motto">{t.motto}</p>
      {
        /* numer i href składane w JS (antyscraping); bez JS kotwica
           zostaje ukryta, a do kontaktu prowadzą przyciski niżej */
      }
      <a class="ft-tel" data-tel href={CONTACT_PATH} hidden>Telefon</a>
      <a class="ft-cta" href={CONTACT_PATH}>{t.cta}</a>
    </div>

    {
      /* mobile: dwa przyciski; etykiety stałe, JS podmienia WYŁĄCZNIE cel
         (data-fill="href") — bez JS prowadzą na /kontakt/ */
    }
    <div class="ft-btns">
      <a
        class="ft-btn ft-btn--call"
        data-tel
        data-fill="href"
        href={CONTACT_PATH}>{t.call}</a
      >
      <a class="ft-btn" data-mail="biuro" data-fill="href" href={CONTACT_PATH}
        >{t.write}</a
      >
    </div>

    <nav class="ft-nav" aria-label={t.sitemap}>
      {footerNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="ft-data">
      <address class="ft-row">
        <span class="ft-k">{t.office}</span>
        <a href={MAPS_URL} target="_blank" rel="noopener noreferrer">
          {BUSINESS.street}, {BUSINESS.postalCode}
          {BUSINESS.locality}
        </a>
      </address>
      <p class="ft-row">
        <span class="ft-k">{t.hours}</span>
        <span>{t.hoursValue}</span>
      </p>
      <p class="ft-row">
        <span class="ft-k">{t.mail}</span>
        <a data-mail="biuro" href={CONTACT_PATH} hidden>E-mail</a>
      </p>
      <p class="ft-row ft-row--company">
        <span class="ft-k">{t.company}</span>
        <span>
          {BUSINESS.legalName}, {BUSINESS.seatStreet}, {BUSINESS.seatPostalCode}
          {BUSINESS.seatLocality}, NIP {NIP}, REGON {BUSINESS.regon}
        </span>
      </p>
    </div>
  </div>

  <div class="ft-bot">
    <div class="ft-bot-in">
      <span>{t.copyright}</span>
      <a class="ft-policy" href={POLICY_PATH}>{t.policy}</a>
      <span class="ft-made">
        {t.madeBy}
        <a href="https://hadrianm.pl" target="_blank" rel="noopener"
          >{t.madeByName}</a
        >{t.madeBySuffix}
      </span>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--navy);
    color: #fff;
    font-family: var(--font-body);
  }
  .ft a {
    color: #fff;
    text-decoration: none;
  }
  .ft a:focus-visible {
    outline: 2px solid var(--copper-light);
    outline-offset: 3px;
  }
  .ft p {
    margin: 0;
  }

  .ft-main {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 5.6vw, 26px);
    max-width: var(--col);
    margin-inline: auto;
    box-sizing: content-box;
    padding: clamp(30px, 8.4vw, 38px) var(--pad) clamp(24px, 6.6vw, 30px);
  }

  /* rząd 1 (mobile): logo + telefon; hasło pod spodem; CTA tylko desktop */
  .ft-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(20px, 5.6vw, 26px) 16px;
  }
  .ft-logo {
    display: block;
    flex: none;
    height: clamp(22px, 6.2vw, 26px);
  }
  .ft-logo img {
    display: block;
    width: auto;
    height: 100%;
  }
  .ft-motto {
    flex: 1 1 100%;
    order: 3;
    max-width: 260px;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
    text-wrap: pretty;
  }
  .ft-tel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-label);
    font-weight: 500;
    font-size: clamp(18px, 5.2vw, 21px);
    line-height: 1;
    letter-spacing: -0.01em;
    border-bottom: 1px solid rgba(201, 130, 54, 0.7);
  }
  .ft-tel[hidden],
  .ft-row a[hidden] {
    display: none;
  }
  .ft-cta {
    display: none;
  }

  /* przyciski (mobile) */
  .ft-btns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px;
  }
  .ft-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    font-size: 15px;
    font-weight: 600;
  }
  /* `.ft a` ustawia biel — przycisk miedziany potrzebuje ciemnego tekstu
     (biel na miedzi = 3,0:1, poniżej AA); stąd wyższa specyficzność */
  .ft .ft-btn--call {
    border-color: var(--copper);
    background: var(--copper);
    color: var(--ink);
  }

  .ft-tel:hover,
  .ft-nav a:hover,
  .ft-row a:hover,
  .ft-made a:hover {
    color: var(--copper);
  }
  .ft-btn:hover,
  .ft-cta:hover {
    border-color: var(--copper);
    color: var(--copper);
  }
  .ft .ft-btn--call:hover {
    background: var(--copper-hover);
    border-color: var(--copper-hover);
    color: var(--ink);
  }

  /* mapa strony: pastylki (mobile) */
  .ft-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: clamp(16px, 4.6vw, 20px);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .ft-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 15px;
  }

  /* dane firmy */
  .ft-data {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: clamp(16px, 4.6vw, 20px);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }
  .ft-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 8px;
    min-height: 32px;
    font-style: normal;
  }
  /* Etykiety: design α .45 nie trzyma AA na granacie — .7 (R6). */
  .ft-k {
    color: rgba(255, 255, 255, 0.7);
  }

  /* pas dolny */
  .ft-bot {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.14);
  }
  .ft-bot-in {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: var(--col);
    margin-inline: auto;
    box-sizing: content-box;
    padding: clamp(14px, 4vw, 18px) var(--pad);
    font-size: 12px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }
  .ft-policy {
    order: -1;
    align-self: flex-start;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.24);
  }
  .ft-policy:hover {
    color: var(--copper);
  }
  .ft-made a {
    border-bottom: 1px solid rgba(201, 130, 54, 0.7);
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .ft-main {
      gap: clamp(26px, 2.6vw, 38px);
      padding: clamp(36px, 3.6vw, 54px) var(--pad) clamp(28px, 2.8vw, 40px);
    }
    .ft-top {
      justify-content: flex-start;
      gap: 16px clamp(24px, 3vw, 56px);
    }
    .ft-logo {
      height: clamp(22px, 2.2vw, 30px);
    }
    .ft-motto {
      flex: 0 1 auto;
      order: 0;
      max-width: 32ch;
      font-size: clamp(14px, 1.4vw, 17px);
    }
    .ft-tel {
      margin-left: auto;
      min-height: 48px;
      font-size: clamp(24px, 2.5vw, 34px);
      letter-spacing: -0.02em;
      border-bottom: none;
    }
    .ft-cta {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 clamp(16px, 1.6vw, 22px);
      border: 1px solid rgba(255, 255, 255, 0.4);
      font-size: 15px;
    }
    /* bez JS telefon jest ukryty — CTA samo dosuwa się do prawej */
    .ft-tel[hidden] + .ft-cta {
      margin-left: auto;
    }
    .ft-btns {
      display: none;
    }

    .ft-nav {
      gap: clamp(20px, 2.4vw, 44px);
      padding: clamp(16px, 1.8vw, 24px) 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    }
    .ft-nav a {
      min-height: 32px;
      padding: 0;
      border: none;
      font-family: var(--font-label);
      font-size: 13px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .ft-data {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px clamp(20px, 2.6vw, 48px);
      padding-top: 0;
      border-top: none;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.72);
    }
    .ft-row {
      min-height: 0;
    }

    .ft-bot-in {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: clamp(16px, 2vw, 32px);
      padding: clamp(14px, 1.4vw, 20px) var(--pad);
      font-size: 13px;
    }
    .ft-policy {
      order: 0;
      align-self: auto;
      min-height: 0;
    }
    .ft-made {
      margin-left: auto;
    }
  }
</style>

<script>
  import { fillContactSlots } from "@/lib/contact-details";

  // Telefon/mail stopki (antyscraping). Idempotentne względem wypełnienia
  // z Navbara (te same wartości do tych samych slotów).
  fillContactSlots();
</script>
