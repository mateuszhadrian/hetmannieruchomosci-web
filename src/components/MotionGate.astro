---
// Bramka ruchu stron treściowych — skrypt INLINE w <head>, przed
// malowaniem: przy prefers-reduced-motion: no-preference nadaje
// html.js-motion (uzbraja stany startowe reveali i zapas kadrów parallaxu
// z content.css); moduł ruchu strony (`<widok>-motion.ts`) ładuje się
// osobno, dynamicznym import(). Bezpiecznik: 3 s po `load` klasa schodzi,
// jeśli moduł ruchu się nie wczytał (nie ustawił `data-motion` na <html>)
// — treść NIGDY nie zostaje ukryta. Bez JS i przy reduce klasy nie ma:
// strona jest statyczna i kompletna (.claude/rules/sections.md).
//
// Użycie: `<MotionGate slot="head" />` wewnątrz BaseLayout — strony
// z ruchem: „/", /sprzedaj-z-nami/, /o-nas/, /uslugi/.
//
// Komentarze stoją TUTAJ, nie w skrypcie: `is:inline` wysyła treść
// skryptu bez zmian, razem z komentarzami, na każdej stronie.
---

<script is:inline>
  if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    const root = document.documentElement;
    root.classList.add("js-motion");
    addEventListener("load", () => {
      setTimeout(() => {
        if (!root.hasAttribute("data-motion")) {
          root.classList.remove("js-motion");
        }
      }, 3000);
    });
  }
</script>
