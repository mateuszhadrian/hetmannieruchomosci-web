---
// Strona-szkielet Etapu 0: nagłówek + tytuł + stopka. Daje działającą
// nawigację po wszystkich 8 trasach ZANIM powstaną widoki (Etapy 4–5
// wymieniają szkielety na docelowe sekcje po jednym PR-ze). Selektor
// `main h1` to kontrakt testów smoke/navigation — zostaje w widokach
// docelowych.
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/navbar/Navbar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  /** <title> dokumentu (BaseLayout dokleja canonical/OG). */
  title: string;
  /** Nagłówek h1 widoczny na szkielecie. */
  heading: string;
  /** Opcjonalny meta description (podstrony). */
  description?: string;
}
const { title, heading, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Navbar />
  <main class="skel">
    <h1>{heading}</h1>
    <p>Strona w przygotowaniu.</p>
    {/* treść szkieletowa tras ofert (2.8); trasy statyczne nic tu nie dają */}
    <slot />
  </main>
  <Footer />
</BaseLayout>

<style>
  .skel {
    min-height: 60vh;
    max-width: var(--col);
    margin-inline: auto;
    box-sizing: content-box;
    /* pasek chrome'u jest FIXED — treść startuje pod nim */
    padding: calc(var(--hdr-h) + clamp(24px, 2.6vw, 48px)) var(--pad)
      clamp(64px, 6vw, 96px);
  }
  .skel h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(24px, 7.2vw, 42px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--navy);
    text-wrap: pretty;
    margin: 0 0 14px;
  }
  .skel p {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }

  /* ════ DESKTOP ≥1025 (breakpoint projektu) ════ */
  @media (min-width: 1025px) {
    .skel h1 {
      font-size: clamp(34px, 3.6vw, 54px);
      line-height: 1.1;
    }
  }
</style>
